{
  "version": "jdk16",
  "buildConfigurations": {
    "x64Mac": {
      "os": "mac",
      "arch": "x64",
      "additionalNodeLabels": "macos10.14",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64Linux": {
      "os": "linux",
      "arch": "x64",
      "dockerImage": {
        "hotspot": "adoptopenjdk/centos6_build_image",
        "openj9": "adoptopenjdk/centos7_build_image"
      },
      "dockerFile": {
        "openj9": "pipelines/build/dockerFiles/cuda.dockerfile"
      },
      "additionalTestLabels": {
        "openj9": "!(centos6||rhel6)"
      },
      "configureArgs": {
        "openj9": "--enable-dtrace --enable-jitserver",
        "hotspot": "--enable-dtrace"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "x64AlpineLinux": {
      "os": "alpine-linux",
      "arch": "x64",
      "dockerImage": "adoptopenjdk/alpine3_build_image",
      "configureArgs": "--enable-headless-only=yes",
      "additionalSmokeTestNodeLabels": ""
    },
    "aarch64AlpineLinux": {
      "os": "alpine-linux",
      "arch": "aarch64",
      "dockerImage": "adoptopenjdk/alpine3_build_image",
      "configureArgs": "--enable-headless-only=yes",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64Windows": {
      "os": "windows",
      "arch": "x64",
      "additionalNodeLabels": "win2012&&vs2017",
      "additionalSmokeTestNodeLabels": ""
    },
    "x32Windows": {
      "os": "windows",
      "arch": "x86-32",
      "additionalNodeLabels": "win2012&&vs2017",
      "buildArgs": {
        "hotspot": "--jvm-variant client,server"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "ppc64Aix": {
      "os": "aix",
      "arch": "ppc64",
      "additionalNodeLabels": {
        "hotspot": "xlc16&&aix710",
        "openj9": "xlc16&&aix715"
      },
      "cleanWorkspaceAfterBuild": true,
      "additionalSmokeTestNodeLabels": ""
    },
    "s390xLinux": {
      "os": "linux",
      "arch": "s390x",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "ppc64leLinux": {
      "os": "linux",
      "arch": "ppc64le",
      "additionalNodeLabels": "centos7",
      "configureArgs": {
        "hotspot": "--enable-dtrace",
        "openj9": "--enable-dtrace --enable-jitserver"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "aarch64Linux": {
      "os": "linux",
      "arch": "aarch64",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "configureArgs": "--enable-dtrace",
      "testDynamic": false,
      "additionalSmokeTestNodeLabels": ""
    },
    "arm32Linux": {
      "os": "linux",
      "arch": "arm",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    }
  },
  "targetConfigurations": [
    "x64Mac",
    "x64Linux",
    "x64AlpineLinux",
    "aarch64AlpineLinux",
    "x64Windows",
    "x32Windows",
    "ppc64Aix",
    "s390xLinux",
    "ppc64leLinux",
    "aarch64Linux",
    "arm32Linux"
  ],
  "openjdkVersion": "jdk16u",
  "enabled": false
}