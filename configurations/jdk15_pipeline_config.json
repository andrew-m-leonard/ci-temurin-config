{
  "version": "jdk15",
  "buildConfigurations": {
    "x64Mac": {
      "os": "mac",
      "arch": "x64",
      "additionalNodeLabels": "macos10.14",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64MacXL": {
      "os": "mac",
      "arch": "x64",
      "additionalNodeLabels": "macos10.14",
      "additionalFileNameTag": "macosXL",
      "configureArgs": "--with-noncompressedrefs --enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64Linux": {
      "os": "linux",
      "arch": "x64",
      "dockerImage": {
        "hotspot": "adoptopenjdk/centos6_build_image",
        "openj9": "adoptopenjdk/centos7_build_image"
      },
      "dockerFile": {
        "openj9": "pipelines/build/dockerFiles/cuda.dockerfile"
      },
      "additionalTestLabels": {
        "openj9": "!(centos6||rhel6)"
      },
      "configureArgs": {
        "openj9": "--enable-dtrace --enable-jitserver",
        "hotspot": "--enable-dtrace"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "x64LinuxXL": {
      "os": "linux",
      "arch": "x64",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "dockerFile": {
        "openj9": "pipelines/build/dockerFiles/cuda.dockerfile"
      },
      "additionalTestLabels": {
        "openj9": "!(centos6||rhel6)"
      },
      "additionalFileNameTag": "linuxXL",
      "configureArgs": "--with-noncompressedrefs --enable-dtrace --enable-jitserver",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64Windows": {
      "os": "windows",
      "arch": "x64",
      "additionalNodeLabels": "win2012&&vs2017",
      "additionalSmokeTestNodeLabels": ""
    },
    "x64WindowsXL": {
      "os": "windows",
      "arch": "x64",
      "additionalNodeLabels": "win2012&&vs2017",
      "additionalFileNameTag": "windowsXL",
      "configureArgs": "--with-noncompressedrefs",
      "additionalSmokeTestNodeLabels": ""
    },
    "x32Windows": {
      "os": "windows",
      "arch": "x86-32",
      "additionalNodeLabels": "win2012&&vs2017",
      "buildArgs": {
        "hotspot": "--jvm-variant client,server"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "ppc64Aix": {
      "os": "aix",
      "arch": "ppc64",
      "additionalNodeLabels": {
        "hotspot": "xlc16&&aix710",
        "openj9": "xlc16&&aix715"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "s390xLinux": {
      "os": "linux",
      "arch": "s390x",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "s390xLinuxXL": {
      "os": "linux",
      "arch": "s390x",
      "additionalFileNameTag": "linuxXL",
      "configureArgs": "--with-noncompressedrefs --enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "ppc64leLinux": {
      "os": "linux",
      "arch": "ppc64le",
      "additionalNodeLabels": "centos7",
      "configureArgs": {
        "hotspot": "--enable-dtrace",
        "openj9": "--enable-dtrace --enable-jitserver"
      },
      "additionalSmokeTestNodeLabels": ""
    },
    "ppc64leLinuxXL": {
      "os": "linux",
      "arch": "ppc64le",
      "additionalNodeLabels": "centos7",
      "additionalFileNameTag": "linuxXL",
      "configureArgs": "--with-noncompressedrefs --disable-ccache --enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "arm32Linux": {
      "os": "linux",
      "arch": "arm",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "aarch64Linux": {
      "os": "linux",
      "arch": "aarch64",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "configureArgs": "--enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    },
    "aarch64LinuxXL": {
      "os": "linux",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "arch": "aarch64",
      "additionalFileNameTag": "linuxXL",
      "configureArgs": "--with-noncompressedrefs --enable-dtrace",
      "additionalSmokeTestNodeLabels": ""
    }
  },
  "targetConfigurations": [
    "x64Mac",
    "x64MacXL",
    "x64Linux",
    "x64LinuxXL",
    "x64Windows",
    "x64WindowsXL",
    "x32Windows",
    "ppc64Aix",
    "s390xLinux",
    "s390xLinuxXL",
    "ppc64leLinux",
    "ppc64leLinuxXL",
    "arm32Linux",
    "aarch64Linux",
    "aarch64LinuxXL"
  ],
  "openjdkVersion": "jdk15u",
  "enabled": false
}